{
  "name": "red30-dashboard-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Appium + WebdriverIO end-to-end tests for the Red30 Dashboard mobile app (iOS and Android)",
  "type": "module",
  "scripts": {
    "setup:android": "appium driver install uiautomator2",
    "setup:ios": "appium driver install xcuitest",
    "setup:inspector": "appium plugin install inspector",
    "doctor:android": "appium driver doctor uiautomator2",
    "doctor:ios": "appium driver doctor xcuitest",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.1",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.8.0",
    "appium-inspector-plugin": "^2026.9.2",
    "appium-uiautomator2-driver": "^8.7.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "webdriverio": "^9.32.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
